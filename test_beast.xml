    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:output" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.output" spec="TaxonSet">
                    <alignment idref="output"/>
                </taxonset>
            </tree>
            <parameter id="birthRate.t:output" spec="parameter.RealParameter" lower="0.0" name="stateNode">1.0</parameter>
        </state>
        <init id="RandomTree.t:output" spec="RandomTree" estimate="false" initial="@Tree.t:output" taxa="@output">
            <populationModel id="ConstantPopulation0.t:output" spec="ConstantPopulation">
                <parameter id="randomPopSize.t:output" spec="parameter.RealParameter" name="popSize">1.0</parameter>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="YuleModel.t:output" spec="beast.base.evolution.speciation.YuleModel" birthDiffRate="@birthRate.t:output" tree="@Tree.t:output"/>
                <prior id="YuleBirthRatePrior.t:output" name="distribution" x="@birthRate.t:output">
                    <Uniform id="Uniform.1" name="distr" upper="Infinity"/>
                </prior>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.output" spec="ThreadedTreeLikelihood" data="@output" tree="@Tree.t:output">
                    <siteModel id="SiteModel.s:output" spec="SiteModel">
                        <parameter id="mutationRate.s:output" spec="parameter.RealParameter" estimate="false" lower="0.0" name="mutationRate">1.0</parameter>
                        <parameter id="gammaShape.s:output" spec="parameter.RealParameter" estimate="false" lower="0.1" name="shape">1.0</parameter>
                        <parameter id="proportionInvariant.s:output" spec="parameter.RealParameter" estimate="false" lower="0.0" name="proportionInvariant" upper="1.0">0.0</parameter>
                        <substModel id="LewisMK.s:output" spec="morphmodels.evolution.substitutionmodel.LewisMK">
                            <datatype idref="standard"/>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:output" spec="beast.base.evolution.branchratemodel.StrictClockModel">
                        <parameter id="clockRate.c:output" spec="parameter.RealParameter" estimate="false" lower="0.0" name="clock.rate">1.0</parameter>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="YuleBirthRateScaler.t:output" spec="kernel.BactrianScaleOperator" parameter="@birthRate.t:output" upper="10.0" weight="3.0"/>
        <operator id="YuleModelTreeRootScaler.t:output" spec="kernel.BactrianScaleOperator" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:output" upper="10.0" weight="3.0"/>
        <operator id="YuleModelUniformOperator.t:output" spec="kernel.BactrianNodeOperator" tree="@Tree.t:output" weight="30.0"/>
        <operator id="YuleModelSubtreeSlide.t:output" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:output" weight="15.0"/>
        <operator id="YuleModelNarrow.t:output" spec="Exchange" tree="@Tree.t:output" weight="15.0"/>
        <operator id="YuleModelWide.t:output" spec="Exchange" isNarrow="false" tree="@Tree.t:output" weight="3.0"/>
        <operator id="YuleModelWilsonBalding.t:output" spec="WilsonBalding" tree="@Tree.t:output" weight="3.0"/>
        <operator id="YuleModelBICEPSEpochTop.t:output" spec="EpochFlexOperator" scaleFactor="0.1" tree="@Tree.t:output" weight="2.0"/>
        <operator id="YuleModelBICEPSEpochAll.t:output" spec="EpochFlexOperator" fromOldestTipOnly="false" scaleFactor="0.1" tree="@Tree.t:output" weight="2.0"/>
        <operator id="YuleModelBICEPSTreeFlex.t:output" spec="TreeStretchOperator" scaleFactor="0.01" tree="@Tree.t:output" weight="2.0"/>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.output"/>
            <log id="TreeHeight.t:output" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:output"/>
            <log idref="YuleModel.t:output"/>
            <log idref="birthRate.t:output"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:output" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="1000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:output" spec="beast.base.evolution.TreeWithMetaDataLogger" tree="@Tree.t:output"/>
        </logger>
        <operatorschedule id="OperatorSchedule" spec="OperatorSchedule"/>
    </run>

</beast>
